# Copia a .env y ajusta. Prefijo SUNAT_.

# Puerto del microservicio Flask.
SUNAT_PORT=8090

# Navegador: false = VISIBLE (recomendado, pasa mejor el WAF de SUNAT); true = oculto.
SUNAT_PLAYWRIGHT_HEADLESS=false

# Seguridad: si se setea, el backend Spring debe enviar el header X-API-Key con este valor.
SUNAT_API_KEY=
