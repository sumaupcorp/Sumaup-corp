# ==== SUMAUP360 — Producción (copia a .env y completa TODO) ====
# NUNCA subas el .env real a git (ya está ignorado).

# ---- Dominio ----
# Tu dominio raíz SIN protocolo. Los servicios usan subdominios:
#   api.<DOMAIN>  app.<DOMAIN>  staff.<DOMAIN>
DOMAIN=tudominio.com
# Email para los certificados HTTPS (Let's Encrypt).
ACME_EMAIL=tucorreo@tudominio.com

# ---- Base de datos (PostgreSQL en el contenedor) ----
DB_NAME=sumaup360_db
DB_USER=sumaup
# Genera una contraseña larga y aleatoria.
DB_PASSWORD=CAMBIA_ESTA_PASSWORD

# ---- Firebase (mismo proyecto del ecosistema) ----
# El archivo va en ./secrets/firebase-service-account.json (NO en git).
FIREBASE_PROJECT_ID=sumaup-dev
FIREBASE_WEB_API_KEY=AIzaSyApS-7hHNpoSKI7JKHClT7oVSWEKnZ6f60
FIREBASE_STORAGE_BUCKET=sumaup-dev.firebasestorage.app

# ---- Seguridad backend ----
# UID del super-admin de bootstrap (queda STAFF admin al iniciar sesión).
BOOTSTRAP_ADMIN_UID=nM7QwIy19ZUlMJJi0buTiSMEJeG3
# Secreto JWT interno: genera uno largo y aleatorio (ej: openssl rand -base64 48).
JWT_SECRET=CAMBIA_ESTE_SECRETO_LARGO_Y_ALEATORIO
# Orígenes permitidos para CORS (coma-separados): saas, backoffice y tu landing.
# Nota: el landing (https://sumaup360.com y www) ya está SIEMPRE permitido desde el
# código (SecurityConfig.ALWAYS_ALLOWED_ORIGINS) para que el QR público nunca se rompa;
# aquí se agregan los demás orígenes (saas/backoffice) según tus subdominios reales.
CORS_ALLOWED_ORIGINS=https://app.sumaup360.com,https://staff.sumaup360.com,https://sumaup360.com

# ---- SUNAT (microservicio interno) ----
# Clave compartida backend<->sunat. Genera una aleatoria.
SUNAT_API_KEY=CAMBIA_ESTA_CLAVE

# ---- IA ----
AI_PROVIDER=openai
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=AQ...

# ---- Frontends (se hornean en el build de las imágenes) ----
# URL del backend que consumirán saas y backoffice (normalmente api.<DOMAIN>).
SAAS_API_BASE_URL=https://api.tudominio.com
BACKOFFICE_API_BASE_URL=https://api.tudominio.com
# Config Firebase web (pública, va en el bundle del cliente).
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyApS-7hHNpoSKI7JKHClT7oVSWEKnZ6f60
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=sumaup-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=sumaup-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=sumaup-dev.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
